# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key

# Database Configuration
# NOTE: If running on the same Hostinger server, DB_HOST can be localhost.
# If connecting remotely, you must use Hostinger's MySQL server hostname (e.g. sqlXXX.main-hosting.eu or the server IP)
# and authorize your external IP address in Hostinger hPanel.
DB_HOST=sql1085.main-hosting.eu
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=u156958239_moil_hr_app

# SFTP Sync Configuration
# For local SSH reverse tunneling, use host 127.0.0.1 and port 2222.
# For direct VPS connections, use the client's actual SFTP host and port.
SFTP_HOST=127.0.0.1
SFTP_PORT=2222
SFTP_USER=sftp_username
SFTP_PASS=sftp_password
SFTP_EMPLOYEES_PATH=/path/to/employees.csv
SFTP_HOLIDAYS_PATH=/path/to/holidays.csv
